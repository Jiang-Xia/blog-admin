{
  "name": "blog-admin",
  "description": "Blog Admin for Vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "jiang-xia",
  "license": "MIT",
  "scripts": {
    "dev:debug": "vite --debug --config ./config/vite.config.dev.ts",
    "dev": "vite --config ./config/vite.config.dev.ts",
    "dev:go-online": "vite --config ./config/vite.config.dev.ts --mode go-online",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "build:plain": "cross-env VITE_ENABLE_OBFUSCATE=false npm run build",
    "report": "cross-env REPORT=true npm run build",
    "preview": "npm run build && vite preview --host",
    "lint-staged": "npx lint-staged",
    "prepare": "husky install",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy/pm2/deploy.ps1",
    "rollback": "powershell -ExecutionPolicy Bypass -File deploy/pm2/rollback.ps1",
    "rollback:list": "powershell -ExecutionPolicy Bypass -File deploy/pm2/rollback.ps1 -List"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "jsencrypt": "^3.5.4",
    "md-editor-v3": "^7.0.0",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "query-string": "^9.5.1",
    "shepherd.js": "^15.3.0",
    "sm-crypto": "^0.5.7",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.0",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/crypto-js": "^4.2.2",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^26.6.2",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "~10.11.0",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.7.0",
    "jsdom": "^30.1.0",
    "less": "^4.9.1",
    "lint-staged": "^17.5.1",
    "mockjs": "^1.1.0",
    "prettier": "3.9.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.15.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.6",
    "vite-plugin-bundle-obfuscator": "^1.13.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china",
    "gifsicle": "5.2.0",
    "console": "consola"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "echarts-wordcloud": {
      "echarts": "^6.1.0"
    }
  }
}
