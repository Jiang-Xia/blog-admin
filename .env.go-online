# 本地前端 dev → 线上 Go 单体（Nginx /x-blog-go/api/v1 → :8000）
# 用法：pnpm dev:go-online
# 对照：blog-server/deploy/nginx/conf.d/jiang-xia.top.conf

VITE_API_BASE_URL = https://jiang-xia.top/x-blog-go/api/v1
VITE_PREFIX_PATH = /x-blog-go
VITE_NUXT_OPEN_ENCRYPT = false
# 网关套件 aes|gm，须与 Nest app_gatewayCrypto 一致
VITE_NUXT_GATEWAY_CRYPTO = aes

# 上传静态与 Nest 共用 public 目录
VITE_API_STATIC_URL = https://jiang-xia.top/x-api/blog-server
