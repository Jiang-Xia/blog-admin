# Docker 本地试验：管理端直连宿主机映射的 Go 单体 :8000
# 构建时复制为 .env.production（vite.config.prod 固定 production mode）

VITE_API_BASE_URL = http://localhost:8000/api/v1
VITE_PREFIX_PATH = /api/v1
VITE_NUXT_OPEN_ENCRYPT = false
# 网关套件 aes|gm，须与 Nest app_gatewayCrypto 一致
VITE_NUXT_GATEWAY_CRYPTO = aes

VITE_API_STATIC_URL = http://localhost:8000
# Docker 本地联调关闭，便于 DevTools 排障
VITE_ENABLE_OBFUSCATE = false
