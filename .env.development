VITE_API_BASE_URL = http://localhost:5000/api/v1
# VITE_API_BASE_URL = https://jiang-xia.top/x-blog/api/v1
# 线上 Go 单体：pnpm dev:go-online（见 .env.go-online → /x-blog-go/api/v1）
# VITE_API_BASE_URL = http://localhost:5000/api/v1
VITE_PREFIX_PATH = /x-blog
VITE_NUXT_OPEN_ENCRYPT = true
# 网关套件 aes|gm，须与 Nest app_gatewayCrypto 一致
VITE_NUXT_GATEWAY_CRYPTO = aes
# 开发态是否打印加解密分步耗时（[gateway-crypto] xxx Nms）；默认关，排查性能时再开
VITE_NUXT_GATEWAY_CRYPTO_LOG = false

# 静态资源域名（上传后预览）
VITE_API_STATIC_URL = http://localhost:5000
# 登录人机验证固定方式（仅 DEV 生效）：graphic | slide | click | rotate；留空则随机
VITE_CAPTCHA_MODE = rotate
# dev 关闭混淆，便于排查
VITE_ENABLE_OBFUSCATE = true
