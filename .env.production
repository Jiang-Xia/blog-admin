VITE_API_BASE_URL = https://jiang-xia.top/x-blog/api/v1
VITE_NUXT_OPEN_ENCRYPT = true
# 网关套件 aes|gm，须与 Nest app_gatewayCrypto 一致
VITE_NUXT_GATEWAY_CRYPTO = aes

VITE_API_STATIC_URL = https://jiang-xia.top/x-api/blog-server
# 生产开启轻量混淆（仅标识符 + 剥 console；勿开 transformObjectKeys / debugProtection）
VITE_ENABLE_OBFUSCATE = true
